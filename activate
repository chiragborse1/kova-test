#!/usr/bin/env bash
# ============================================================================
# venv-style activation for the Kova dev environment (pm-managed tools).
#
#   source ./activate      (bash / zsh, repo root)
#   .\activate.ps1         (PowerShell)
#
# Emits the composed pm env (PATH + tool vars) into the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `kova` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `kova pm
# install` and `kova update` keep that check.
# ============================================================================
_KOVA_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_kova_test_env="--test-environment"
_kova_expect_extras=""
for _kova_arg in "$@"; do
    if [ -n "$_kova_expect_extras" ]; then
        _kova_test_env="--test-environment=$_kova_arg"
        _kova_expect_extras=""
        continue
    fi
    case "$_kova_arg" in
        --) break ;;
        --test-extras) _kova_expect_extras=1 ;;
        --test-extras=*) _kova_test_env="--test-environment=${_kova_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_kova_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _kova_arg _kova_test_env _kova_expect_extras
    return 2 2>/dev/null || exit 2
fi
# Setup runs in a child: failures must not exit or partially activate the
# caller's shell, and activation must not republish launchers or shell config.
if ! (
    unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
    bash "$_KOVA_REPO/setup-kova.sh" --runtime-only "$_kova_test_env"
) >&2; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _kova_arg _kova_test_env _kova_expect_extras
    return 1 2>/dev/null || exit 1
fi
unset _kova_arg _kova_test_env _kova_expect_extras

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __KOVA_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

# Bootstrap Python only emits the environment; it does not install anything.
_kova_repo="$_KOVA_REPO"
_kova_py=""
for _kova_candidate in "$_kova_repo/.venv/bin/python" "$_kova_repo/.venv/Scripts/python.exe" \
                         "$_kova_repo/venv/bin/python" "$_kova_repo/venv/Scripts/python.exe"; do
    [ -x "$_kova_candidate" ] && { _kova_py="$_kova_candidate"; break; }
done
if [ -z "$_kova_py" ]; then
    for _kova_store in "${KOVA_RUNTIME_DIR:-}" "$_kova_repo/../tools" "${KOVA_HOME:-$HOME/.kova}/tools"; do
        [ -n "$_kova_store" ] || continue
        for _kova_candidate in "$_kova_store"/python-*/bin/python3 "$_kova_store"/python-*/python.exe "$_kova_store"/python-*/bin/python "$_kova_store"/python-*/bin/python.exe; do
            [ -x "$_kova_candidate" ] && { _kova_py="$_kova_candidate"; break; }
        done
        [ -n "$_kova_py" ] && break
    done
fi
if [ -z "$_kova_py" ]; then
    echo "activate: no bootstrap Python found; run setup-kova.sh" >&2
    return 1 2>/dev/null || exit 1
fi

# --- emit export lines from `pm env` ---
_kova_json="$(PYTHONHOME= PYTHONPATH="$_kova_repo" "$_kova_py" -m pm.environments)"
if [ -z "$_kova_json" ] || [ "${_kova_json#*{}" = "$_kova_json" ]; then
    echo "activate: could not read pm env (run ./setup-kova.sh first)" >&2
    unset _kova_repo _kova_os _kova_arch _kova_target _kova_store _kova_py _kova_json
    return 1 2>/dev/null || exit 1
fi

_kova_keys="$(printf '%s' "$_kova_json" | "$_kova_py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))' \
    | tr ' ' '\n' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | tr '\n' ' ')"
[ -n "$_kova_keys" ] || _kova_keys="PATH"

# --- snapshot what we are about to change (deactivate restores this) ---
# __KOVA_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__KOVA_SAVED_PATH="$PATH"
for _kova_k in $_kova_keys; do
    eval "__KOVA_SAVED_$_kova_k=\"\${$_kova_k+set}\""
    eval "__KOVA_PRIOR_$_kova_k=\${$_kova_k-__KOVA_UNSET__}"
done

# Resolved before the export below replaces PATH.
_kova_cygpath="$(command -v cygpath 2>/dev/null || :)"

eval "$(printf '%s' "$_kova_json" | "$_kova_py" -c '
import json, sys, shlex, re
for k, v in json.load(sys.stdin).items():
    # Windows carries names like ProgramFiles(ARM) that are not valid
    # bash identifiers — skip them (they pass through untouched).
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
        continue
    print("export %s=%s" % (k, shlex.quote(str(v))))')"

# The MSYS/Cygwin runtime hands a native Windows Python these variables in
# Windows form (`C:\a;C:\b`) and converts them back only for its own children.
# Exported verbatim, bash splits PATH on ':' and finds no commands.
if [ -n "$_kova_cygpath" ]; then
    PATH="$("$_kova_cygpath" -u -p "$PATH")"
    for _kova_k in HOME TMPDIR TMP TEMP; do
        if [ -n "${!_kova_k-}" ]; then
            printf -v "$_kova_k" '%s' "$("$_kova_cygpath" -u "${!_kova_k}")"
        fi
    done
fi

# This checkout, not whichever `kova` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__KOVA_WORKTREE="$_kova_repo"
# The branch names the worktree. A checkout cannot share a branch with another.
__KOVA_WORKTREE_NAME="$(git -C "$_kova_repo" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__KOVA_WORKTREE_NAME" ] || [ "$__KOVA_WORKTREE_NAME" = HEAD ]; then
    __KOVA_WORKTREE_NAME="$(basename "$_kova_repo")"
fi
__KOVA_SAVED_PS1="${PS1-__KOVA_UNSET__}"
__KOVA_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__KOVA_UNSET__}"

_kova_worktree_here() {
    _kova_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_kova_top" && pwd -P)" = "$(cd "$__KOVA_WORKTREE" && pwd -P)" ]
}

kova() {
    _kova_worktree_here || {
        printf '%s\n' "kova: $(pwd) is outside $__KOVA_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__KOVA_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" kova "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe kova "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python kova "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe kova "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python kova "$@"
        else
            exec python kova "$@"
        fi
    )
}

_kova_prompt() {
    if [ "$__KOVA_SAVED_PS1" = "__KOVA_UNSET__" ]; then
        _kova_base_ps1=""
    else
        _kova_base_ps1="$__KOVA_SAVED_PS1"
    fi
    if _kova_worktree_here; then
        PS1="($__KOVA_WORKTREE_NAME) $_kova_base_ps1"
    else
        PS1="$_kova_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_kova_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_kova_prompt
fi
_kova_prompt

deactivate() {
    export PATH="$__KOVA_SAVED_PATH"
    for _kova_k in $__KOVA_KEY_LIST; do
        eval "_kova_was=\"\$__KOVA_SAVED_$_kova_k\""
        eval "_kova_old=\"\$__KOVA_PRIOR_$_kova_k\""
        if [ "$_kova_was" != "set" ]; then
            unset "$_kova_k"
        else
            export "$_kova_k=$_kova_old"
        fi
        unset "__KOVA_SAVED_$_kova_k" "__KOVA_PRIOR_$_kova_k"
    done
    if [ "$__KOVA_SAVED_PS1" = "__KOVA_UNSET__" ]; then
        unset PS1
    else
        PS1="$__KOVA_SAVED_PS1"
    fi
    if [ "$__KOVA_SAVED_PROMPT_COMMAND" = "__KOVA_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__KOVA_SAVED_PROMPT_COMMAND"
    fi
    unset __KOVA_SAVED_PATH __KOVA_KEY_LIST __KOVA_ACTIVATED \
          __KOVA_WORKTREE __KOVA_WORKTREE_NAME \
          __KOVA_SAVED_PS1 __KOVA_SAVED_PROMPT_COMMAND
    unset -f deactivate kova _kova_worktree_here _kova_prompt
    unset _kova_k _kova_was _kova_old _kova_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__KOVA_KEY_LIST="$_kova_keys"

unset _kova_repo _kova_os _kova_arch _kova_target _kova_store \
      _kova_py _kova_json _kova_keys _kova_k _kova_entry _kova_venvpy \
      _kova_winarch _kova_top _kova_cygpath
